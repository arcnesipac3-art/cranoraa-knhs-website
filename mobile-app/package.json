{
  "name": "school-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start": "expo start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc",
    "prebuild": "expo prebuild --fix-poet",
    "postinstall": "husky install"
  },
  "dependencies": {
    "expo": "^52.0.36",
    "expo-router": "^4.0.5",
    "expo-status-bar": "^2.0.1",
    "react": "^19.0.3",
    "react-native": "^0.79.3",
    "react-query": "^3.39.3",
    "axios": "^1.7.7",
    "react-hook-form": "^7.51.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0-rc.0",
    "@react-native-async-storage/async-storage": "~2.1.1",
    "expo-secure-store": "~13.1.1",
    "expo-notifications": "^0.29.2",
    "expo-camera": "^16.0.0",
    "expo-image-picker": "^16.0.0",
    "expo-file-system": "~18.0.1",
    "react-native-reanimated": "~3.17.0",
    "react-native-gesture-handler": "~2.23.0",
    "@react-navigation/native": "^7.0.19",
    "react-native-svg": "^15.0.1",
    "@expo/vector-icons": "^14.0.3",
    "react-native-paper": "^5.12.5",
    "date-fns": "^2.30.0",
    "lucide-react-native": "^0.480.0",
    "react-native-qrcode-svg": "^6.3.0",
    "react-native-biometrics": "^5.0.0",
    "expo-local-authentication": "~14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.23.8",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.14.204",
    "@types/react": "^19.0.3",
    "@types/react-native": "^0.73.24",
    "typescript": "^5.7.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "husky": "^9.1.1",
    "lint-staged": "^15.2.10",
    "jest": "^29.7.0",
    "jest-expo": "^53.0.1",
    "@typescript-eslint/parser": "^7.0.2",
    "@typescript-eslint/eslint-plugin": "^7.0.2"
  },
  "eslintConfig": {
    "extends": [
      "eslint-config-prettier",
      "plugin:react/recommended",
      "@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaFeatures": {
        "jsx": true
      },
      "ecmaVersion": 2020,
      "sourceType": "module"
    },
    "plugins": ["react", "@typescript-eslint"],
    "rules": {
      "react/react-in-jsx-scope": "off",
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/no-explicit-any": "warn"
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  },
  "overrides": [
    {
      "files": ["*.js", "*.jsx", "*.ts", "*.tsx"],
      "rules": {
        "quotes": [
          "error",
          "single",
          {
            "avoidEscape": true,
            "allowTemplateLiterals": true
          }
        ],
        "semi": ["error", "never"]
      }
    }
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "expo": {
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "package": "com.knhs.school.mobile"
          }
        }
      ]
    ]
  },
  "packageManager": "npm@10.8.1"
}