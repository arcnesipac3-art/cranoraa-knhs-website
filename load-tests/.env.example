# K6 Load Testing Configuration
# Copy this file to .env and adjust values as needed

# Backend URL
BASE_URL=http://localhost:8000

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Test scenario (smoke, load, stress, spike, soak)
SCENARIO=load

# Test user credentials (must exist in database)
TEST_STUDENT_USERNAME=test_student
TEST_STUDENT_PASSWORD=TestPassword123!

TEST_TEACHER_USERNAME=test_teacher
TEST_TEACHER_PASSWORD=TestPassword123!

TEST_ADMIN_USERNAME=test_admin
TEST_ADMIN_PASSWORD=TestPassword123!

# K6 Cloud settings (optional)
# K6_CLOUD_TOKEN=your_token_here
# K6_CLOUD_PROJECT_ID=your_project_id
