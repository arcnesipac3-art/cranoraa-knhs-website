# ─── Backend API ─────────────────────────────────────────────────────────────
# URL of the Django backend origin or API root (no trailing slash).
# Both http://localhost:8000 and http://localhost:8000/api are accepted.
VITE_API_URL=http://localhost:8000

# ─── Firebase (Required for push notifications) ──────────────────────────────
# 1. Go to Firebase Console → Project Settings → General
# 2. Under "Your apps", click the web app (</>) icon to find these values
# 3. Copy each value exactly as shown
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
# VAPID key from Firebase Console → Project Settings → Cloud Messaging → Web configuration
VITE_FIREBASE_VAPID_KEY=your-vapid-key


